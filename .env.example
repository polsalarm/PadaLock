# PadaLock env. Copy to apps/web/.env.local

# "mainnet" switches NETWORK/RPC/Horizon + contract id resolution to the
# *_MAINNET vars below. Any other value (or unset) stays on testnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed PadaLock contract on Stellar testnet (USDC-bound instance)
NEXT_PUBLIC_PADALOCK_CONTRACT_ID=

# XLM-bound PadaLock instance (native SAC) — enables XLM padalas
NEXT_PUBLIC_PADALOCK_XLM_CONTRACT_ID=

# USDC SAC contract id on testnet (wrap your own testnet USDC asset via stellar CLI)
NEXT_PUBLIC_USDC_SAC_TESTNET=

# XLM native Stellar Asset Contract id on testnet
NEXT_PUBLIC_XLM_SAC_TESTNET=

# --- Mainnet (only used when NEXT_PUBLIC_STELLAR_NETWORK=mainnet) ---
# Deployed PadaLock contract on Stellar mainnet (USDC-bound instance)
NEXT_PUBLIC_PADALOCK_CONTRACT_ID_MAINNET=CBE7OMDVRVC2DEDZXXVKF6EHUTPM5FYFVB2IP27W2PI24WHI4AAZNQVK
# XLM-bound PadaLock instance on mainnet (not deployed yet)
NEXT_PUBLIC_PADALOCK_XLM_CONTRACT_ID_MAINNET=
# Circle USDC SAC contract id on mainnet
NEXT_PUBLIC_USDC_SAC_MAINNET=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# Circle USDC classic issuer on mainnet
NEXT_PUBLIC_USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Optional feedback collection
# Discord incoming webhook for visible feedback messages.
FEEDBACK_WEBHOOK_URL=
# Deployed @padalock/feedback-graph base URL, without a path. The app posts to /api/ingest.
FEEDBACK_GRAPH_URL=
# Must match the feedback-graph deployment if INGEST_SECRET is set there.
INGEST_SECRET=
